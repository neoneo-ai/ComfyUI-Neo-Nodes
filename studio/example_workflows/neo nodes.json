ame":"random_count"},"link":null},{"localized_name":"instance_uid","name":"instance_uid","shape":7,"type":"STRING","widget":{"name":"instance_uid"},"link":null}],"outputs":[{"localized_name":"PROMPT","name":"PROMPT","shape":6,"type":"STRING","links":[]},{"localized_name":"BUNDLE","name":"BUNDLE","type":"STRING","links":[32]}],"properties":{"cnr_id":"comfyui-neo-nodes","ver":"7b55542437c7551f9155e4582059e0b7ff5f68d3","Node name for S&R":"NeoPromptAgent","rs_disable_state":true,"rs_waiting_prompt":"","rs_waiting_timestamp":0,"rs_instance_uid":"rs_inst_57f7c34d8549472e9bd1a05824789b29","ue_properties":{"widget_ue_connectable":{},"input_ue_unconnectable":{},"version":"7.8"},"rs_selected_skill":"","rs_quick_input":"","rs_quick_input_used":false,"rs_auto_generate":false,"rs_runtime_random":{"enabled":false,"count":1}},"widgets_values":["生成视频：东方暗黑奇幻动作电影，IMAX 电影质感，虚幻引擎级光影，黑紫泼墨符术，极高速近身格斗，真实物理反馈。暗影符术师与暗影魔将保持参考图人物的外观、服饰、发型、武器和比例一致。符纹具备流动、凝聚、爆散三种状态，动作连贯，打击有明确受力，禁止肢体畸变、武器变形、角色瞬移和无因果爆炸。  【0—1 秒｜压迫起势】 贴地极低角度仰拍，暗影符术师单棍拄地、沉身蓄力，黑紫墨纹沿棍身蔓延至地面裂缝，形成不规则符阵。对面魔将拖刀蓄势，浓烈魔气凝成巨型刀影。双方能量对撞，地面扩散环形墨色震纹。镜头沿裂缝极速推进，切入符术师眼神特写。她嘴角上扬，眼神阴冷兴奋，低声发笑：“嘿嘿……”  【1—3.5 秒｜高速突击】 0.2—0.4 秒级碎切，保持攻击方向连续。魔将抡刀猛冲，符术师贴地侧滑闪避，棍身拖出黑紫墨痕；旋身扫击下盘，利用棍身格挡重刀并卸力，随后垫步跃起，棍端反击面部防护区域。棍刀相撞，墨色星火与环形冲击纹爆散。镜头切换低角度追拍、侧向跟移、俯视闪避、武器特写。符术师边战边低笑：“哈…… 哈……”  【3.5—6.5 秒｜近身压制】 360° 环绕跟拍，高低机位快速切换，确保人物空间关系清晰。符术师连续施展旋棍、反身横扫、上挑和短距突击，攻击魔将肩甲、腰侧、膝部等防护薄弱位置。利用棍身变向卸力后反击，长棍划出密集黑紫墨弧，形成不断收紧的能量网。魔将肩甲、臂甲、胸甲接连出现符纹爆裂，碎石与魔气飞溅。符术师神情逐渐癫狂，放声大笑：“哈哈哈哈……” 每次命中都表现接触、受力、装甲震动和能量扩散。  【6.5—8 秒｜震波反制】 镜头从魔将背后俯冲。魔将重刀劈地，黑紫瘴气炸开，地面大面积龟裂。符术师横棍承受冲击，借力后空翻拉开距离，周围符纹迅速汇聚至棍端。魔将挥刀追击，她在空中旋身避开刀锋，以棍重击刀背，使刀势偏转，胸口防御暴露。落地瞬间再次爆发冲刺，棍身拖出长条墨影，脚下连续炸开符纹光痕。她发出尖锐笑声：“呵啊哈哈哈哈……”  【8—9.5 秒｜符雷绝杀】 镜头从低空仰拍快速升至宏大俯视全景。符术师跃入高空，战场残余符纹逆流汇聚棍端，凝成巨型符术雷棍虚影。黑紫墨浪围绕长棍旋转，乌云被牵引成旋涡状符阵。她双手持棍全力下砸，厉声喊道：“都给我 —— 碎啊！” 棍端与重刀正面碰撞，刀身先出现蛛网裂纹，随后层层崩碎。黑紫符罡贯穿魔将，魔气如墨入水般爆散。地面炸开巨大环形雷痕，碎石、断链和熔岩光痕被掀起。碰撞核心插入不超过 0.5 秒慢镜，依次突出棍尖落点、刀体崩裂、墨浪爆发与地面开裂，随后恢复快切。  【9.5—10 秒｜冷冽收束】 近距离侧拍推进。符术师稳稳落地，单棍拄地，长发与衣摆随余波翻飞。身后魔将解体为散落墨迹，残余雷光沿棍身收敛，只留下巨大雷痕。她露出阴冷满足的笑容，眼神明亮而危险。镜头定格侧脸与持棍姿态，墨迹缓慢沉降，完成战斗闭环。  【生成约束】 保持人物、服饰、发型、武器和场景连续。动作遵循攻击、闪避、受力、反击的因果关系。统一黑紫泼墨能量风格，避免重复挥棍、无接触攻击、肢体抽搐、武器消失、瞬移和失控残影。节奏由蓄势、突击、压制、反制、绝杀逐级升级",true,false,"","",false,false,1,"rs_inst_57f7c34d8549472e9bd1a05824789b29",""],"widgets_values_named":{"prompt":"生成视频：东方暗黑奇幻动作电影，IMAX 电影质感，虚幻引擎级光影，黑紫泼墨符术，极高速近身格斗，真实物理反馈。暗影符术师与暗影魔将保持参考图人物的外观、服饰、发型、武器和比例一致。符纹具备流动、凝聚、爆散三种状态，动作连贯，打击有明确受力，禁止肢体畸变、武器变形、角色瞬移和无因果爆炸。  【0—1 秒｜压迫起势】 贴地极低角度仰拍，暗影符术师单棍拄地、沉身蓄力，黑紫墨纹沿棍身蔓延至地面裂缝，形成不规则符阵。对面魔将拖刀蓄势，浓烈魔气凝成巨型刀影。双方能量对撞，地面扩散环形墨色震纹。镜头沿裂缝极速推进，切入符术师眼神特写。她嘴角上扬，眼神阴冷兴奋，低声发笑：“嘿嘿……”  【1—3.5 秒｜高速突击】 0.2—0.4 秒级碎切，保持攻击方向连续。魔将抡刀猛冲，符术师贴地侧滑闪避，棍身拖出黑紫墨痕；旋身扫击下盘，利用棍身格挡重刀并卸力，随后垫步跃起，棍端反击面部防护区域。棍刀相撞，墨色星火与环形冲击纹爆散。镜头切换低角度追拍、侧向跟移、俯视闪避、武器特写。符术师边战边低笑：“哈…… 哈……”  【3.5—6.5 秒｜近身压制】 360° 环绕跟拍，高低机位快速切换，确保人物空间关系清晰。符术师连续施展旋棍、反身横扫、上挑和短距突击，攻击魔将肩甲、腰侧、膝部等防护薄弱位置。利用棍身变向卸力后反击，长棍划出密集黑紫墨弧，形成不断收紧的能量网。魔将肩甲、臂甲、胸甲接连出现符纹爆裂，碎石与魔气飞溅。符术师神情逐渐癫狂，放声大笑：“哈哈哈哈……” 每次命中都表现接触、受力、装甲震动和能量扩散。  【6.5—8 秒｜震波反制】 镜头从魔将背后俯冲。魔将重刀劈地，黑紫瘴气炸开，地面大面积龟裂。符术师横棍承受冲击，借力后空翻拉开距离，周围符纹迅速汇聚至棍端。魔将挥刀追击，她在空中旋身避开刀锋，以棍重击刀背，使刀势偏转，胸口防御暴露。落地瞬间再次爆发冲刺，棍身拖出长条墨影，脚下连续炸开符纹光痕。她发出尖锐笑声：“呵啊哈哈哈哈……”  【8—9.5 秒｜符雷绝杀】 镜头从低空仰拍快速升至宏大俯视全景。符术师跃入高空，战场残余符纹逆流汇聚棍端，凝成巨型符术雷棍虚影。黑紫墨浪围绕长棍旋转，乌云被牵引成旋涡状符阵。她双手持棍全力下砸，厉声喊道：“都给我 —— 碎啊！” 棍端与重刀正面碰撞，刀身先出现蛛网裂纹，随后层层崩碎。黑紫符罡贯穿魔将，魔气如墨入水般爆散。地面炸开巨大环形雷痕，碎石、断链和熔岩光痕被掀起。碰撞核心插入不超过 0.5 秒慢镜，依次突出棍尖落点、刀体崩裂、墨浪爆发与地面开裂，随后恢复快切。  【9.5—10 秒｜冷冽收束】 近距离侧拍推进。符术师稳稳落地，单棍拄地，长发与衣摆随余波翻飞。身后魔将解体为散落墨迹，残余雷光沿棍身收敛，只留下巨大雷痕。她露出阴冷满足的笑容，眼神明亮而危险。镜头定格侧脸与持棍姿态，墨迹缓慢沉降，完成战斗闭环。  【生成约束】 保持人物、服饰、发型、武器和场景连续。动作遵循攻击、闪避、受力、反击的因果关系。统一黑紫泼墨能量风格，避免重复挥棍、无接触攻击、肢体抽搐、武器消失、瞬移和失控残影。节奏由蓄势、突击、压制、反制、绝杀逐级升级","disable_text_input":true,"auto_generate":false,"quick_input":"","skill_id":"","quick_input_used":false,"random_enabled":false,"random_count":1,"instance_uid":"rs_inst_57f7c34d8549472e9bd1a05824789b29","prompt_ui":""}},{"id":30,"type":"ResolutionSelector","pos":[-468.6354771678437,1584.3495269925218],"size":[270,170],"flags":{},"order":7,"mode":4,"showAdvanced":false,"inputs":[{"localized_name":"宽高比","name":"aspect_ratio","type":"COMBO","widget":{"n